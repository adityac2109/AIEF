# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Environment, credentials and key material
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.ppk
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
credentials*.json
secrets*.json
*.secret

# Local-only notes and audit reports (never published)
/.local/

# Data: raw IMS archives and anything derived from them live outside the repo
# (see data/README.md). Only the README is tracked here.
data/*
!data/README.md
*.zip
*.rar

# Experiment outputs and model artifacts (root-anchored so that source
# packages such as src/bearingguard/models/ are not ignored)
/artifacts/
/models/
/runs/
*.log
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.h5
*.pt
*.pth
*.onnx
*.sqlite
*.db

